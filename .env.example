# DATABASE_URL: Neon Postgres connection string (server-side only, never exposed to the browser)
# Example: postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
DATABASE_URL=

# API_PORT: Port the Express API server listens on (default 8787)
API_PORT=8787

# ADMIN_PASSKEY: passkey the admin exchanges for a bearer token (match the client passkey)
ADMIN_PASSKEY=5309
# ADMIN_TOKEN: long random secret that authorizes protected API calls.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# NEON_API_KEY: Neon API key for CLI / SDK access to your Neon project (server-side only)
NEON_API_KEY=

# APP_URL: The URL where this app is hosted
APP_URL=
